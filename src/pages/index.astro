r{display:none}.faq summary:after{content:'+';position:absolute;right:3px;top:17px;color:var(--orange);font:400 22px var(--sans)}.faq details[open] summary:after{content:'−'}.faq details p{max-width:620px;margin:-2px 35px 20px 0;color:#536057;font-size:13px;line-height:1.8}.contact{padding:83px 0;background:#e4d3b9}.contact-inner{display:grid;grid-template-columns:1.15fr .85fr;gap:8%;align-items:center}.contact h2{max-width:650px}.contact-copy>p:not(.kicker){max-width:510px;margin:18px 0 0;color:#4b594f;font-size:14px}.contact-actions{display:flex;flex-wrap:wrap;gap:11px;margin-top:25px}.contact .btn-secondary{border-color:#819084}.contact-aside{padding:25px;border-left:1px solid #bda98f}.contact-aside p{margin:0 0 12px;font-size:12px;color:#4d5a50}.contact-aside a{display:block;margin:7px 0;font-size:13px;font-weight:600;text-underline-offset:3px}.contact-aside small{display:block;margin-top:16px;color:#556256;font-size:10px;line-height:1.7}footer{padding:28px 0 34px}.footer-main{display:flex;align-items:center;justify-content:space-between;gap:20px}.footer-links{display:flex;gap:22px}.footer-links a{color:#4e5c53;font-size:11px;text-decoration:none}.footer-small{color:#667067;font-size:10px}.footer-note{margin:18px 0 0;padding-top:14px;border-top:1px solid var(--line);color:#5c685e;font-size:9px}.footer-credit{margin:9px 0 0;color:#6d786e;font-size:10px}.footer-credit a{color:var(--green);text-underline-offset:3px}.mobile-cta{display:none}.reveal{opacity:0;transform:translateY(13px);transition:opacity .55s ease,transform .55s ease}.is-visible{opacity:1;transform:none}.hero-copy{animation:arrive .7s ease both}.portrait-wrap{animation:arrive .85s .08s ease both}@keyframes arrive{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
