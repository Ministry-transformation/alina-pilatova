:1fr;gap:12px}.offer-card{min-height:270px;padding:25px 23px}.offer-card h3{font-size:30px}.notes{padding:68px 0}.notes-top{display:block;margin-bottom:22px}.notes h2{font-size:38px}.note-card{grid-template-columns:1fr;gap:17px;padding:21px 0}.note-card h3{font-size:27px}.note-content p{font-size:13px}.faq-layout{grid-template-columns:1fr;gap:23px}.faq summary{font-size:18px}.contact{padding:64px 0}.contact-inner{grid-template-columns:1fr;gap:25px}.contact-aside{padding:17px 0 0;border-left:0;border-top:1px solid #bda98f}.contact-actions{gap:8px}.footer-main{align-items:flex-start;flex-wrap:wrap}.footer-links{gap:15px}.footer-small{width:100%}.footer-note{font-size:9px}.mobile-cta{position:fixed;z-index:9;bottom:12px;left:12px;right:12px;display:flex;align-items:center;justify-content:center;gap:10px;min-height:49px;background:var(--green);color:#fff;text-decoration:none;box-shadow:0 7px 24px #172b2152;font-size:12px;font-weight:600}.mobile-cta span{font-size:18px}.footer-credit{padding-bottom:56px}}
