---
const telegram = 'https://t.me/alinapilatova_psy';
const whatsapp = 'https://wa.me/qr/JLWXHTICZED3I1';
const helloMessage = encodeURIComponent('Здравствуйте, Алина. Хочу обсудить встречу-знакомство. Подскажите, пожалуйста, как можно начать?');
const diagnosticMessage = encodeURIComponent('Здравствуйте, Алина. Хочу узнать о диагностической встрече: как она проходит и можно ли договориться?');
const tgHello = `${telegram}?text=${helloMessage}`;
const tgDiagnostic = `${telegram}?text=${diagnosticMessage}`;
const base = import.meta.env.BASE_URL;
