const telegram = 'https://t.me/alinapilatova_psy';
const whatsapp = 'https://wa.me/qr/JLWXHTICZED3I1';
const helloMessage = encodeURIComponent('Здравствуйте, Алина. Хотела бы договориться о встрече-знакомстве. Подскажите, пожалуйста, как это можно сделать?');
const diagnosticMessage = encodeURIComponent('Здравствуйте, Алина. Хотела бы узнать о диагностической встрече: как она проходит и можно ли записаться?');
const tgHello = `${telegram}?text=${helloMessage}`;
const tgDiagnostic = `${telegram}?text=${diagnosticMessage}`;
const base = import.meta.env.BASE_URL;
