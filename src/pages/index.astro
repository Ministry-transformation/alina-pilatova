    <script>
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-ready');
        const observer = new IntersectionObserver((entries, io) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); io.unobserve(entry.target); } }), { threshold: .12, rootMargin: '0px 0px -28px 0px' });
        document.querySelectorAll('.section-head,.topic,.step,.offer-card,.note-card,.faq-list details,.about-image,.about-copy > *,.contact-copy > *').forEach((element) => { element.classList.add('reveal'); observer.observe(element); });
      }
    </script>
